# VITE_GEMINI_KEY: Required for Gemini AI API calls.
# Configure this in your .env file for local development
# For Vercel deployment, configure as environment variable in Vercel dashboard
VITE_GEMINI_KEY=sua_chave_aqui

# Supabase Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Código de convite exigido para criar uma conta na tela de cadastro.
# Compartilhe apenas com quem for usar o sistema (ex: avaliadores da competição).
VITE_INVITE_CODE=escolha_um_codigo_aqui
